# EcoSphere Environment Configuration
SECRET_KEY=ecosphere-hackathon-super-secret-key-12345
FLASK_APP=run.py
FLASK_ENV=development

# MySQL Database Configuration
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ecosphere

# If MySQL is not configured or fails to connect, Flask will automatically 
# fall back to using SQLite (ecosphere.db) in the root folder.
